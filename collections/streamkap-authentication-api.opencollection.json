{
  "opencollection": "1.0.0",
  "info": {
    "name": "Streamkap Authentication API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Exchange credentials for a JWT access token.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.streamkap.com/api/authentication/access-token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Exchange credentials for a JWT access token."
        },
        {
          "info": {
            "name": "Refresh an access token using a refresh token.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.streamkap.com/api/authentication/refresh-access-token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Refresh an access token using a refresh token."
        },
        {
          "info": {
            "name": "Return the caller's verified identity.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.streamkap.com/api/authentication/whoami"
          },
          "docs": "Return the caller's verified identity."
        }
      ]
    }
  ],
  "bundled": true
}